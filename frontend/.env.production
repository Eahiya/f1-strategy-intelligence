# =============================================================================
# F1 Strategy Platform — Frontend Production Environment Variables
# These are safe to commit — they reference public backend URLs only.
# Set REACT_APP_API_URL and REACT_APP_WS_HOST to your Railway backend URL
# AFTER Railway deployment is complete.
# =============================================================================

# Backend API URL (Railway deployment URL)
# Format: https://<your-app-name>.up.railway.app
REACT_APP_API_URL=https://your-railway-app.up.railway.app

# WebSocket host (same Railway backend, without protocol)
# Format: <your-app-name>.up.railway.app  (no https://)
# Disable treating warnings as errors in CI environments (e.g. Vercel)
CI=false

